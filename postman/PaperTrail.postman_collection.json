{
  "info": {
    "name": "PaperTrail API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Users - Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.expect(json).to.have.property('id');",
              "pm.environment.set('userId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user+{{$timestamp}}@example.com\",\n  \"role\": \"user\"\n}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "Users - List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "Users - Get",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      }
    },
    {
      "name": "Papers - Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.expect(json).to.have.property('id');",
              "pm.environment.set('paperId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"A Study on PaperTrail {{$timestamp}}\",\n  \"abstract\": \"Minimal abstract\",\n  \"author_id\": \"{{userId}}\",\n  \"pdf_url\": \"https://example.com/paper.pdf\"\n}"
        },
        "url": "{{baseUrl}}/api/papers"
      }
    },
    {
      "name": "Papers - List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": "{{baseUrl}}/api/papers"
      }
    },
    {
      "name": "Papers - Get",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": "{{baseUrl}}/api/papers/{{paperId}}"
      }
    },
    {
      "name": "Reviews - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reviewer_id\": \"{{userId}}\",\n  \"rating\": 5,\n  \"comments\": \"Looks good\"\n}"
        },
        "url": "{{baseUrl}}/api/papers/{{paperId}}/reviews"
      }
    },
    {
      "name": "Reviews - List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": "{{baseUrl}}/api/papers/{{paperId}}/reviews"
      }
    },
    {
      "name": "Comments - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"body\": \"Nice paper\"\n}"
        },
        "url": "{{baseUrl}}/api/papers/{{paperId}}/comments"
      }
    },
    {
      "name": "Comments - List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": "{{baseUrl}}/api/papers/{{paperId}}/comments"
      }
    }
  ]
}
